# ============================================================================
# TuroArnis .gitignore
# ============================================================================
# Purpose: Prevent committing generated artifacts, large binaries, and
#          runtime data that should not be version controlled.
#
# Categories:
#   1. PyInstaller build artifacts
#   2. ML model files (large binaries)
#   3. Database files (runtime data)
#   4. Python cache
#   5. Virtual environments
#   6. IDE settings
#   7. Logs and temporary files
# ============================================================================

# ============================================================================
# 1. PYINSTALLER BUILD ARTIFACTS
# ============================================================================
# These are generated during the build process and can be regenerated
# from source. Never commit build outputs.
# ---------------------------------------------------------------------------
build/                  # PyInstaller work directory
dist/                   # Executable output directory
*.spec                  # Generated spec files (except TuroArnis.spec which is tracked)
*.pkg                   # PyInstaller package files
*.pyz                   # PyInstaller archive files
*.toc                   # PyInstaller table of contents
*.manifest              # Windows manifest files
*.exe                   # Built executables (except in dist/ which is ignored)
*.dll                   # Dynamic libraries (in build/)
# NOTE: TuroArnis.spec is intentionally tracked for reproducible builds

# ============================================================================
# 2. ML MODEL FILES (Large Binaries)
# ============================================================================
# Model files are large (~5-35MB each) and can be regenerated/retrained.
# Keep them in cloud storage or separate asset repository.
# ---------------------------------------------------------------------------
*.pt                    # PyTorch model weights (YOLO)
*.pth                   # PyTorch model checkpoints (GCN)
*.onnx                  # ONNX model files
*.tflite                # TensorFlow Lite models
*.h5                    # Keras/TF model files
*.joblib                # Joblib serialized models
# NOTE: Model configs (JSON) should still be tracked

# ============================================================================
# 3. DATABASE FILES (Runtime Data)
# ============================================================================
# SQLite databases contain runtime user data and should not be committed.
# They are auto-created on first run in %APPDATA%/TuroArnis/
# ---------------------------------------------------------------------------
*.db                    # SQLite databases
turoarnis.db            # Main application database
*.sqlite                # SQLite files
*.sqlite3               # SQLite3 files
*.db-journal            # SQLite journal files
*.db-wal                # SQLite write-ahead logs
*.db-shm                # SQLite shared memory files

# ============================================================================
# 4. PYTHON CACHE AND COMPILED FILES
# ============================================================================
# Bytecode and cache directories are auto-generated by Python.
# ---------------------------------------------------------------------------
__pycache__/            # Python 3 bytecode cache
*.pyc                   # Compiled Python files
*.pyo                   # Optimized compiled Python files
*.pyd                   # Python dynamic modules (Windows)
.Python                 # Python environment marker
*$py.class              # Jython compiled files
*.egg-info/             # Package metadata
*.egg                   # Package distributions
*.py[cod]               # Compiled Python pattern

# ============================================================================
# 5. VIRTUAL ENVIRONMENTS
# ============================================================================
# Virtual environments are platform-specific and should be recreated per machine.
# ---------------------------------------------------------------------------
venv/                   # Default virtual environment
venv_311/               # Python 3.11 virtual environment (project specific)
env/                    # Alternative venv name
ENV/                    # Alternative venv name
.venv/                  # Hidden venv style
.ENV/                   # Hidden venv style (uppercase)
env.bak/                # Backup venv
venv.bak/               # Backup venv
venv_311/

# ============================================================================
# 6. IDE AND EDITOR SETTINGS
# ============================================================================
# IDE-specific configuration files.
# ---------------------------------------------------------------------------
.vscode/                # Visual Studio Code settings
.idea/                  # JetBrains IDEs (PyCharm, IntelliJ)
*.swp                   # Vim swap files
*.swo                   # Vim swap files
*.swn                   # Vim swap files
*~                      # Backup files
*.sublime-*             # Sublime Text files
.project                # Eclipse project file
.pydevproject           # PyDev project file
.settings/              # Eclipse settings

# ============================================================================
# 7. LOGS AND TEMPORARY FILES
# ============================================================================
# Runtime logs and temporary data.
# ---------------------------------------------------------------------------
*.log                   # Log files
build.log               # Build output log
build_test_report.json  # Build test reports
app_startup.log         # Application startup logs
pip-log.txt             # Pip installation logs
pip-delete-this-directory.txt  # Pip temp marker
*.tmp                   # Temporary files
*.temp                  # Temporary files
*.bak                   # Backup files
*.backup                # Backup files
.cache/                 # Cache directories

# ============================================================================
# 8. TEST ARTIFACTS AND RESULTS
# ============================================================================
# Test outputs and evaluation results.
# ---------------------------------------------------------------------------
results_trio/           # Test result images
eval_screenshots/       # Evaluation screenshots
lesson_images/          # Lesson image assets (large)
lesson/                 # Instructional media (GIFs) - tracked in LFS if needed
trio/                   # Training/test images
test_result_*.jpg       # Test output images
output_*.jpg            # Output images
test_multi_user_result_*.jpg  # Multi-user test results
Copy*.jpg               # Copy images
*.gif                   # GIF files (instructional media)

# ============================================================================
# 9. DEPLOYMENT AND DISTRIBUTION
# ============================================================================
# Deployment packages and distribution archives.
# ---------------------------------------------------------------------------
*.zip                   # ZIP archives (distribution)
*.tar.gz                # Tarball archives
*.tar                   # Tar archives
*.7z                    # 7-Zip archives
*.rar                   # RAR archives
deployment_package/src/ # Deployment source copies

# ============================================================================
# 10. OS-SPECIFIC FILES
# ============================================================================
# macOS and Windows system files.
# ---------------------------------------------------------------------------
# macOS
.DS_Store               # macOS folder attributes
.AppleDouble             # macOS resource forks
.LSOverride              # macOS icon override
._*                      # macOS extended attributes
.Spotlight-V100/         # macOS Spotlight
.Trashes/                # macOS trash

# Windows
Thumbs.db               # Windows thumbnail cache
ehthumbs.db             # Windows thumbnail cache (legacy)
Desktop.ini             # Windows folder settings
$RECYCLE.BIN/           # Windows recycle bin
*.stackdump             # Windows crash dumps

# ============================================================================
# 11. DOCUMENTATION BUILD ARTIFACTS
# ============================================================================
# Generated documentation files.
# ---------------------------------------------------------------------------
_build/                 # Sphinx build
docs/_build/            # Sphinx build in docs
docs/_static/generated/ # Generated static files
*.doctrees              # Sphinx doctrees
*.epub                  # EPUB documentation
*.mobi                  # MOBI documentation
*.pdf                   # Generated PDFs

# ============================================================================
# 12. SECURITY AND SECRETS
# ============================================================================
# Never commit secrets or credentials.
# ---------------------------------------------------------------------------
.env                    # Environment variables
.env.local              # Local environment
.env.*.local            # Environment variants
*.pem                   # PEM certificates/keys
*.key                   # Private keys
*.p12                   # PKCS#12 certificates
*.pfx                   # PFX certificates
secrets.yaml            # Secret configuration
secrets.json            # Secret configuration
config.local.py         # Local config with secrets

# ============================================================================
# 13. TRAINING AND YOLO RUNS
# ============================================================================
# YOLO training outputs and runs.
# ---------------------------------------------------------------------------
runs/                   # YOLO training runs
detect/                 # YOLO detection outputs
train/                  # YOLO training outputs
val/                    # YOLO validation outputs
*.cache                 # YOLO cache files
labels.cache            # YOLO labels cache

# ============================================================================
# 14. MISC PROJECT FILES
# ============================================================================
# Other files that should not be committed.
# ---------------------------------------------------------------------------
.build_timestamp        # Build timestamp marker
.pytest_cache/          # Pytest cache
.coverage               # Coverage data
htmlcov/                # HTML coverage reports
tox.ini                 # Tox configuration (if not using)
.hypothesis/            # Hypothesis test database
.mypy_cache/            # MyPy cache
.dmypy.json             # MyPy daemon
dmypy.json              # MyPy daemon

# ============================================================================
# EXCEPTIONS (Explicitly track these)
# ============================================================================
# These files SHOULD be tracked despite matching patterns above.
# Uncomment to enable if needed:
# 
# !app/models/gcn_model_config.json    # Model configuration (small, required)
# !app/models/feature_templates.json   # Feature templates (small, required)
# !app/models/label_encoder.joblib     # Label encoder (small, required)
# !TuroArnis.spec                      # Build specification (tracked)
# !requirements.txt                    # Dependencies (tracked)
test_images/
dist/
results/
installer/